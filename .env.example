# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MUSIC_API_BASE_URL & MUSIC_API_KEY: Server-side credentials for upstream music service.
# Never expose MUSIC_API_KEY to client-side VITE_* variables.
MUSIC_API_BASE_URL=""
MUSIC_API_KEY=""
